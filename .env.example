# Copy to .env (local) or add in Vercel → Settings → Environment Variables.
# Placeholders only. Never put secrets in variables that start with VITE_:
# those are bundled into the browser code.

# Public site address, used for canonical links, sitemap and social previews.
VITE_SITE_URL=https://your-domain.example
# Allow search engines only for a real, verified deployment.
VITE_ALLOW_INDEXING=false

# WhatsApp number in international format without "+", e.g. 91XXXXXXXXXX.
# Leave empty to let WhatsApp ask which chat to use.
VITE_WHATSAPP_NUMBER=

# Turn on once at least one server-side destination below is configured.
VITE_ENQUIRY_API_ENABLED=false

# Optional chatbot embed (public URL of a hosted chatbot page).
VITE_CHATBOT_ENABLED=false
VITE_CHATBOT_URL=

# Optional future catalogue API (read-only, public).
VITE_CATALOGUE_API_ENABLED=false
VITE_CATALOGUE_API_URL=

# ---- Server-side only (used by /api/enquiry.js, never sent to the browser) ----
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
POWER_AUTOMATE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=enquiries
